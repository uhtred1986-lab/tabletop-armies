{
  "name": "tabletop-armies",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Tabletop Armies: private companion for miniature games — collection, paint tracker, list builder and table play.",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.mts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest --run",
    "tokens": "node scripts/build-tokens.mjs",
    "gate": "node scripts/gate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.0.11",
    "next": "16.4.3",
    "openid-client": "^6.6.2",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@next/env": "16.4.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
