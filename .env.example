# Copy to .env.local (never committed). Names only here, never values (docs/architecture/platform.md).

# Neon: the pooled connection string of the production branch (Vercel's Neon integration sets it).
DATABASE_URL=
# Cloud sessions only: raw TCP 5432 is blocked there, so talk to Neon over WebSockets.
# DB_DRIVER=neon-ws

# Sign-in (Google). AUTH_SECRET: 32+ random characters (`openssl rand -base64 48`).
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in: comma-separated Google addresses.
OWNER_EMAILS=
# Local dev without Google: everything passes under `next dev` only.
# AUTH_DISABLED=1

# The pre-migration backup on a production deploy (scripts/vercel-build.mts). Vercel Production env only.
NEON_API_KEY=
NEON_PROJECT_ID=

# Private Vercel Blob store for owner photos and reviewed card images.
BLOB_READ_WRITE_TOKEN=
# Optional namespace for an isolated development database's images.
# BLOB_PATH_PREFIX=development/v1/
